{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.3.0",
  "FriendlyName": "Universal Production Tools",
  "Description": "Batch animation retargeting with a measured quality report, plus reference-video assisted cinematic blocking. Works on humanoid, non-human and quadruped rigs.",
  "Category": "Animation",
  "CreatedBy": "Heewon Lee",
  "DocsURL": "https://github.com/heewonle/universal-production-tools",
  "SupportURL": "https://github.com/heewonle/universal-production-tools/issues",
  "CanContainContent": false,
  "EnabledByDefault": false,
  "IsBetaVersion": true,
  "Modules": [{ "Name": "UniversalProductionTools", "Type": "Editor", "LoadingPhase": "Default" }],
  "Plugins": [
    { "Name": "LevelSequenceEditor", "Enabled": true },
    { "Name": "SequencerScripting", "Enabled": true },
    { "Name": "IKRig", "Enabled": true },
    { "Name": "ControlRig", "Enabled": true }
  ]
}
